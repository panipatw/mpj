---
// Components are imported here, in the frontmatter, just like JS modules.
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// `Astro.props` is data passed IN from whichever page uses this layout.
// We give `description` a default so pages don't have to supply one.
interface Props {
	title: string;
	description?: string;
}
const { title, description = 'The personal site of panipatw.' } = Astro.props;

// Files in `public/` are also served under the base path in production,
// so the favicon link needs the same prefix as our internal links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
		<meta name="generator" content={Astro.generator} />
		<!-- These two lines change per page because they come from props -->
		<title>{title} · panipatw</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<div class="container">
			<Nav />
			<main>
				<!-- Each page's unique content gets injected right here -->
				<slot />
			</main>
			<Footer />
		</div>
	</body>
</html>

<!-- `is:global` opts this <style> out of scoping so it applies site-wide.
     Everything else we write stays scoped to its own component. -->
<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-family:
			system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			sans-serif;
		line-height: 1.6;
		color: #1a1a1a;
	}

	body {
		margin: 0;
	}

	.container {
		max-width: 720px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}

	main {
		min-height: 60vh;
	}

	h1 {
		font-size: 2rem;
		margin: 2rem 0 1rem;
	}

	a {
		color: #2563eb;
	}
</style>
