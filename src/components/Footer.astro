---
// This runs at BUILD time (not in the browser), so the year is baked into the
// HTML when the site is generated.
const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const socials = [
	{ label: 'Email', href: 'mailto:panipat.blog498@silomails.com' },
	{ label: 'GitHub', href: 'https://github.com/panipatw' },
];
---

<footer>
	<div class="container inner">
		<p class="copy">&copy; {year} panipatw. Built with Astro.</p>
		<nav class="social" aria-label="Social links">
			{socials.map((s) => <a href={s.href}>{s.label}</a>)}
		</nav>
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 2rem 0;
		border-top: 1px solid var(--border);
		background: color-mix(in srgb, var(--surface) 40%, transparent);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.copy {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.social {
		display: flex;
		gap: 1.25rem;
	}

	.social a {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.social a:hover {
		color: var(--accent);
	}
</style>
