---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Products are CMS-managed content (edited via /keystatic, stored as YAML in
// src/content/products/). Files have no inherent order, so sort explicitly.
const products = (await getCollection('products')).sort(
	(a, b) => a.data.order - b.data.order,
);

// Base path for internal links / assets (CLAUDE.md rule).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
	title="Shop"
	description="A small collection of fictional hand-made pottery."
>
	<!-- PAGE HEADER ----------------------------------------------------- -->
	<section class="container head hero-in" style="--i: 0">
		<p class="eyebrow">The studio</p>
		<h1>Pottery</h1>
		<p class="lead prose">
			A small collection of hand-thrown pieces. Everything here is
			created with love and care, and is meant to be used and enjoyed in your home.
		</p>
	</section>

	<!-- PRODUCT GRID ---------------------------------------------------- -->
	<section class="container section">
		<div class="grid">
			{
				products.map(({ data: product }, i) => (
					<article class="card reveal" style={`--i: ${i % 4}`}>
						{product.image ? (
							<Image
								class="thumb"
								src={product.image}
								alt={product.alt || product.name}
								widths={[320, 640, 960]}
								sizes="(max-width: 560px) 92vw, 320px"
							/>
						) : (
							<span
								class="thumb"
								style={`background: linear-gradient(135deg, ${product.from}, ${product.to})`}
							/>
						)}
						<div class="body">
							<h2>{product.name}</h2>
							<p>{product.blurb}</p>
						</div>
					</article>
				))
			}
		</div>

		<p class="note">
			This is a demo shop, all items are fictional and for demonstration purposes only.
		</p>
	</section>
</Layout>

<style>
	.head {
		padding: 4rem 1.5rem 1rem;
	}

	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.18em;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--text-muted);
		margin: 0 0 0.75rem;
	}

	.lead {
		font-size: 1.15rem;
	}

	.section {
		padding: 2rem 1.5rem 3rem;
	}

	/* Responsive columns, no media queries — see the note in index.astro. */
	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}

	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		transition:
			transform 0.25s var(--ease),
			border-color 0.25s var(--ease);
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
	}

	/* `aspect-ratio` reserves the image's space before it loads, so the grid
	   never jumps. :global() because the <Image> component's <img> is outside
	   this file's style scope; nesting under .card keeps it local in practice. */
	.card :global(.thumb) {
		display: block;
		aspect-ratio: 4 / 3;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	/* The gradient placeholder gets an inner glow for a hint of "photo" depth
	   (an inset shadow would be invisible on a real <img> anyway). */
	span.thumb {
		box-shadow: inset 0 -60px 80px -40px rgba(0, 0, 0, 0.55);
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.15rem 1.25rem 1.35rem;
	}

	.card h2 {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.card p {
		margin: 0;
		font-size: 0.92rem;
	}

	.note {
		margin-top: 2rem;
		text-align: center;
		font-size: 0.9rem;
		color: var(--text-muted);
	}
</style>
