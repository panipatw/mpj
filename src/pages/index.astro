---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<section class="hero">
		<h1>Hi, I'm panipatw 👋</h1>
		<p class="lead">
			Welcome to my corner of the web. This is where I share my projects and
			a few experiments I'm working on.
		</p>
		<p>
			There's an interactive drawing game and more on the way — take a look
			around.
		</p>
	</section>
</Layout>

<style>
	.hero {
		padding: 2rem 0;
	}

	.lead {
		font-size: 1.2rem;
		color: #444;
	}
</style>
