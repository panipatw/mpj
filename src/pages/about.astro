---
import Layout from '../layouts/Layout.astro';

const education = [
	{
		degree: 'PhD in Mechanical Engineering',
		school: 'Imperial College London',
	},
	{
		degree: "Master's and Bachelor's degrees in Mechanical Engineering",
		school: 'Chulalongkorn University, Thailand',
	},
];

const publications = [
	{
		title:
			'Gesture Recognition through Mechanomyogram Signals: An Adaptive Framework for Arm Posture Variability',
		journal: 'IEEE Journal of Biomedical and Health Informatics',
		year: 2025,
		doi: 'https://doi.org/10.1109/JBHI.2024.3483428',
	},
	{
		title:
			'A Performance Study of a Wearable Balance Assistance Device Consisting of Scissored-Pair Control Moment Gyroscopes and a Two-Axis Inclination Sensor',
		journal: 'Journal of Biomechanics',
		year: 2020,
		doi: 'https://doi.org/10.1016/j.jbiomech.2020.109957',
	},
	{
		title: 'Design of Multi-Grip Patterns Prosthetic Hand With Single Actuator',
		journal: 'IEEE Transactions on Neural Systems and Rehabilitation Engineering',
		year: 2018,
		doi: 'https://doi.org/10.1109/TNSRE.2018.2829152',
	},
];
---

<Layout
	title="About"
	description="Machine learning engineer with a background in mechanical engineering and biomechanics, focused on medical devices and healthcare applications."
>
	<section class="container page prose">
		<h1>About</h1>
		<p>
			Hi there, I'm Panipat! I work in applied machine learning, especially in
			medical devices and healthcare applications.
		</p>
		<p>
			I enjoy working across the entire ML pipeline, from research (problem framing, data processing, and model development) 
			to production architecture and deploying robust systems that people actually rely on.
		</p>

		<h2>Background</h2>
		<p>
			I started out in mechanical engineering and biomechanics. During my
			master's degree I developed hand prosthetics, and later worked on hip implants at the Biomechanics lab at
			Chulalongkorn University. Afterwards, I pivoted
			to ML research when I joined the Biomechatronics lab at Imperial College London during my PhD, focused
			on hand gesture recognition for prosthetics and human-machine interfaces.
		</p>
		<p>
			Currently, I'm an ML Engineer at a healthtech startup, working on Parkinson's
			disease monitoring and medication management solutions.
		</p>
		<p>
			That hip implant work also left me with hands-on regulatory experience: I built the Quality Management
			System (QMS) for Class III medical devices and led the lab through its ISO 13485 certification.
			Another skill I picked up along the way is programming and running a
			comprehensive set of industrial manufacturing machines (lathes, 5-axis CNC machining, etc.),
			which could come in handy for prototyping and developing any physical product.
		</p>

		<h2>Education</h2>
		<ul>
			{
				education.map((entry) => (
					<li>
						<strong>{entry.degree}</strong>, {entry.school}
					</li>
				))
			}
		</ul>

		<h2>Selected publications</h2>
		<ul>
			{
				publications.map((pub) => (
					<li>
						<a href={pub.doi}>{pub.title}</a>, <em>{pub.journal}</em>,{' '}
						{pub.year}.
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.page {
		padding: 4rem 1.5rem;
	}

	h2 {
		margin-top: 2.5rem;
	}

	ul {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--text-muted);
	}

	li {
		margin-bottom: 0.6rem;
	}
</style>
